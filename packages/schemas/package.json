{
  "name": "@webmcp-schemas/schemas",
  "version": "0.2.0",
  "description": "Canonical JSON Schema registry for WebMCP tools, organised by industry vertical.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kshitijijari09/webmcp-schemas.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/Kshitijijari09/webmcp-schemas/tree/master/packages/schemas#readme",
  "bugs": {
    "url": "https://github.com/Kshitijijari09/webmcp-schemas/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "json-schema",
    "schemas",
    "retail",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./retail": {
      "import": {
        "types": "./dist/retail.d.ts",
        "default": "./dist/retail.js"
      },
      "require": {
        "types": "./dist/retail.d.cts",
        "default": "./dist/retail.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-ts-mirrors.mjs",
    "prebuild": "pnpm generate",
    "pretest": "pnpm generate",
    "precoverage": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-glob": "^3.3.3",
    "json-schema-to-ts": "^3.1.1"
  }
}

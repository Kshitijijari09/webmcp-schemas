{
  "name": "@webmcp-schemas/schemas",
  "version": "0.0.0",
  "description": "Canonical JSON Schema registry for WebMCP tools, organised by industry vertical.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./retail": {
      "types": "./dist/retail.d.ts",
      "import": "./dist/retail.js",
      "require": "./dist/retail.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-ts-mirrors.mjs",
    "prebuild": "pnpm generate",
    "pretest": "pnpm generate",
    "precoverage": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-glob": "^3.3.3",
    "json-schema-to-ts": "^3.1.1"
  }
}

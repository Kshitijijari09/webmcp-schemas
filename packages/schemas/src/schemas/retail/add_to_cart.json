{
  "id": "retail.add_to_cart",
  "name": "add_to_cart",
  "title": "Add to cart",
  "description": "Add a specific, already-identified product to the shopping cart by productId and quantity. This changes the cart, so it requires user confirmation before it runs. Use check_stock first if availability at the requested quantity is uncertain; use apply_promo_code afterward to apply a discount to the resulting cart.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "productId": { "type": "string", "minLength": 1 },
      "quantity": { "type": "integer", "minimum": 1 }
    },
    "required": ["productId", "quantity"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "cartId": { "type": "string" },
      "lineItemId": { "type": "string" },
      "quantity": { "type": "integer", "minimum": 1 },
      "cartTotal": {
        "type": "object",
        "properties": {
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string" }
        },
        "required": ["amount", "currency"],
        "additionalProperties": false
      }
    },
    "required": ["cartId", "lineItemId", "quantity", "cartTotal"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "untrustedContentHint": false,
    "requiresConfirmation": true
  },
  "stability": "draft",
  "version": "0.1.0"
}

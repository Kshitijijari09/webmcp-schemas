{
  "id": "retail.start_return",
  "name": "start_return",
  "title": "Start return",
  "description": "Begin a return for one or more items from a previously placed order. This starts a real-world return process, so it requires user confirmation before it runs. Use get_order_status first to confirm the order and which items it contains before starting a return.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "orderId": { "type": "string", "minLength": 1 },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "productId": { "type": "string", "minLength": 1 },
            "quantity": { "type": "integer", "minimum": 1 }
          },
          "required": ["productId", "quantity"],
          "additionalProperties": false
        }
      },
      "reason": {
        "type": "string",
        "enum": ["defective", "wrong_item", "no_longer_needed", "better_price_found", "other"]
      }
    },
    "required": ["orderId", "items", "reason"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "returnId": { "type": "string" },
      "status": {
        "type": "string",
        "enum": ["initiated", "awaiting_dropoff", "received", "refunded"]
      },
      "estimatedRefund": {
        "type": "object",
        "properties": {
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string" }
        },
        "required": ["amount", "currency"],
        "additionalProperties": false
      },
      "returnLabelUrl": { "type": "string", "format": "uri" }
    },
    "required": ["returnId", "status"],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "untrustedContentHint": false,
    "requiresConfirmation": true
  },
  "stability": "draft",
  "version": "0.1.0"
}

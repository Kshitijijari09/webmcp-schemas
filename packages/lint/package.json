{
  "name": "@webmcp-schemas/lint",
  "version": "0.2.0",
  "description": "webmcp-lint: checks a site's WebMCP tool registrations against the canonical schema registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kshitijijari09/webmcp-schemas.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/Kshitijijari09/webmcp-schemas/tree/master/packages/lint#readme",
  "bugs": {
    "url": "https://github.com/Kshitijijari09/webmcp-schemas/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "json-schema",
    "linter",
    "cli",
    "playwright",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "webmcp-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^5.0.1",
    "@webmcp-schemas/schemas": "workspace:*",
    "fast-glob": "^3.3.3",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@webmcp-schemas/lint",
  "version": "0.1.0",
  "description": "webmcp-lint: checks a site's WebMCP tool registrations against the canonical schema registry.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "webmcp-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^5.0.1",
    "@webmcp-schemas/schemas": "workspace:*",
    "fast-glob": "^3.3.3",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}

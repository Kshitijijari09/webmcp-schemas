{
  "name": "@webmcp-schemas/runtime",
  "version": "0.1.0",
  "description": "Registers canonical WebMCP schemas on top of the WebMCP polyfill (registerCanonical and friends).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kshitijijari09/webmcp-schemas.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/Kshitijijari09/webmcp-schemas/tree/master/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/Kshitijijari09/webmcp-schemas/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "ai-agents",
    "json-schema",
    "runtime",
    "validation",
    "tool-registration",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mcp-b/webmcp-polyfill": "*"
  },
  "peerDependenciesMeta": {
    "@mcp-b/webmcp-polyfill": {
      "optional": true
    }
  },
  "dependencies": {
    "@webmcp-schemas/schemas": "workspace:*"
  }
}
